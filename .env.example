# Ghost 开发环境配置示例
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件不应提交到 Git

# 站点配置
SITE_URL=http://localhost:2368
SITE_PORT=2368
SITE_HOST=127.0.0.1

# 数据库配置（SQLite）
DB_CLIENT=sqlite3
DB_PATH=content/data/ghost-dev.db

# 管理员账号（首次初始化时使用）
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=your_secure_password_here

# Ghost Content API Key（用于前台搜索功能）
# 在管理后台 Settings → Integrations → Custom Integration 中创建
CONTENT_API_KEY=your_content_api_key_here

# Ghost Admin API Key（用于脚本批量操作）
# 注意：Admin API Key 有较高权限，请勿泄露
ADMIN_API_KEY=your_admin_api_key_here

# 运行环境
NODE_ENV=development

# 日志级别
LOG_LEVEL=info
